    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { getSupabaseConfig } from \"../lib/supabase\";\nimport { Copy, Check, Server, Shield, Database, Layout, AlertCircle, Sparkles } from \"lucide-react\";\n\nexport default function PlanningView() {\n  const [copiedText, setCopiedText] = useState<string | null>(null);\n  const config = getSupabaseConfig();\n\n  const handleCopy = (text: string, id: string) => {\n    navigator.clipboard.writeText(text);\n    setCopiedText(id);\n    setTimeout(() => setCopiedText(null), 2000);\n  };\n\n  const sqlArticles = `\n-- 1. Create the Articles Table\ncreate table public.articles (\n  id text primary key,\n  title text not null,\n  content text not null,\n  image_url text,\n  category text not null,\n  published_at text not null,\n  is_video boolean default false,\n  video_duration text,\n  is_breaking boolean default false,\n  views bigint default 0,\n  author text not null\n);\n\n-- Enable Row Level Security (RLS)\nalter table public.articles enable row level security;\n\n-- Create policies (Anyone can read, only authenticated admins can write)\ncreate policy \"Allow public read access\" on public.articles\n  for select using (true);\n\ncreate policy \"Allow all for authenticated admins\" on public.articles\n  for all using (auth.role() = \'authenticated\');\n`.trim();\n\n  const sqlComments = `\n-- 2. Create the Comments Table\ncreate table public.comments (\n  id text primary key,\n  article_id text not null,\n  author_name text not null,\n  author_email text not null,\n  content text not null,\n  created_at timestamp with time zone default timezone(\'utc\'::text, now()) not null\n);\n\n-- Enable Row Level Security (RLS)\nalter table public.comments enable row level security;\n\n-- Create policies (Anyone can read or post, only admins can delete)\ncreate policy \"Allow public read comments\" on public.comments\n  for select using (true);\n\ncreate policy \"Allow public create comments\" on public.comments\n  for insert with check (true);\n\ncreate policy \"Allow delete for authenticated admins\" on public.comments\n  for delete using (auth.role() = \'authenticated\');\n`.trim();\n\n  return (\n    <div className=\"bg-white rounded-xl border border-gray-200 shadow-sm p-6 max-w-4xl mx-auto my-8\">\n      {/* Header */}\n      <div className=\"flex items-start justify-between border-b border-gray-100 pb-5 mb-6\">\n        <div>\n          <span className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-brand-red/10 text-brand-red mb-2\">\n            <Sparkles className=\"w-3 animate-spin h-3\" /> MASTER BLUEPRINT & PLAN\n          </span>\n          <h2 className=\"text-2xl font-display font-bold text-gray-900 tracking-tight\">\n            Samachar Plus CMS Architecture & Supabase Integration Plan\n          </h2>\n          <p className=\"text-sm text-gray-500 mt-1\">\n            Carefully devised migration sequence, missing features list, schemas and credentials mapping\n          </p>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"text-xs font-mono px-2.5 py-1 rounded-full border flex items-center gap-1.5 bg-gray-50 text-gray-600\">\n            <span className={`w-2 h-2 rounded-full ${config.isValid ? \'bg-green-500\' : \'bg-amber-500\'}`} />\n            {config.isValid ? \"SUPABASE: CONNECTED\" : \"SUPABASE: FALLBACK (LOCAL DB)\"}\n          </span>\n        </div>\n      </div>\n\n      {/* Grid: What was missing vs What we designed */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-8\">\n        <div className=\"bg-amber-50/70 border border-amber-100/80 rounded-lg p-4\">\n          <h3 className=\"font-label-bold text-amber-800 flex items-center gap-2 mb-3\">\n            <AlertCircle className=\"w-4 h-4\" /> 1. What Was Missing in Static Design\n          </h3>\n          <ul className=\"space-y-2.5 text-xs text-amber-900/90 font-body\">\n            <li className=\"flex items-start gap-2\">\n              <span className=\"font-bold text-amber-600\">\342\200\242</span>\n              <span><strong>No Central Database:</strong> Articles were static HTML mockups unable to persist any dynamic inputs.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"font-bold text-amber-600\">\342\200\242</span>\n              <span><strong>CMS Admin Panel:</strong> Administrators had no way to add, edit, or delete articles without writing code.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"font-bold text-amber-600\">\342\200\242</span>\n              <span><strong>User Authentication:</strong> Secure portals with session restrictions was non-existent.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"font-bold text-amber-600\">\342\200\242</span>\n              <span><strong>News Metrics:</strong> Zero logging of post views, click-through counters, or reader comments.</span>\n            </li>\n          </ul>\n        </div>\n\n        <div className=\"bg-emerald-50/70 border border-emerald-100/80 rounded-lg p-4\">\n          <h3 className=\"font-label-bold text-emerald-800 flex items-center gap-2 mb-3\">\n            <Sparkles className=\"w-4 h-4 text-emerald-600\" /> 2. Solution Implemented (In This Phase)\n          </h3>\n          <ul className=\"space-y-2.5 text-xs text-emerald-900/90 font-body\">\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-emerald-600 font-bold\">\342\234\223</span>\n              <span><strong>Crash-Safe Unified Controller:</strong> Initialized a multi-mode local storage database pre-populated with 23 dynamic items, easily bridging to physical servers.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-emerald-600 font-bold\">\342\234\223</span>\n              <span><strong>Fully-Functional Admin Panel:</strong> Built full Create, Read, Update, Delete (CRUD) suite inside the interface.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-emerald-600 font-bold\">\342\234\223</span>\n              <span><strong>Secure Authorization:</strong> Implemented gorgeous admin lock screen allowing custom password guards.</span>\n            </li>\n            <li className=\"flex items-start gap-2\">\n              <span className=\"text-emerald-600 font-bold\">\342\234\223</span>\n              <span><strong>Article Lightbox detailer:</strong> Made interactive layout featuring real commentaries & WhatsApp links.</span>\n            </li>\n          </ul>\n        </div>\n      </div>\n\n      {/* Migration Sequence Plan */}\n      <div className=\"border border-gray-150 rounded-lg p-5 mb-8 bg-gray-50/50\">\n        <h3 className=\"font-display font-bold text-gray-800 flex items-center gap-2 mb-4 text-base\">\n          <Layout className=\"w-5 h-5 text-brand-red\" /> 3-Step Execution Sequence to Bind Supabase\n        </h3>\n        <div className=\"relative border-l-2 border-gray-200 ml-3 pl-6 space-y-6\">\n          {/* Step 1 */}\n          <div className=\"relative\">\n            <span className=\"absolute -left-[31px] top-0 bg-brand-red text-white w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold\">1</span>\n            <h4 className=\"font-label-bold text-xs text-gray-900\">Step 1: Set Up Tables in Supabase Dashboard</h4>\n            <p className=\"text-xs text-gray-500 mt-1 font-body\">\n              Log into your Supabase panel, choose your project, open the <strong>SQL Editor</strong>, and execute the SQL scripts prepared below.\n            </p>\n          </div>\n          {/* Step 2 */}\n          <div className=\"relative\">\n            <span className=\"absolute -left-[31px] top-0 bg-brand-red text-white w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold\">2</span>\n            <h4 className=\"font-label-bold text-xs text-gray-900\">Step 2: Generate Admin User</h4>\n            <p className=\"text-xs text-gray-500 mt-1 font-body\">\n              Go to the <strong>Authentication</strong> tab &gt; <strong>Users</strong> &gt; Click <strong>Add User</strong> to invite your admin email and set your password.\n            </p>\n          </div>\n          {/* Step 3 */}\n          <div className=\"relative\">\n            <span className=\"absolute -left-[31px] top-0 bg-brand-red text-white w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold\">3</span>\n            <h4 className=\"font-label-bold text-xs text-gray-900\">Step 3: Connect Credentials in Developer Settings</h4>\n            <p className=\"text-xs text-gray-500 mt-1 font-body\">\n              Provide your API credentials directly in the **Supabase Connector Modal** inside the Admin Panel, or set them in the server\'s `.env.example` file.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Copyable SQL Scripts */}\n      <div className=\"space-y-6\">\n        <h3 className=\"font-display font-bold text-gray-950 flex items-center gap-2 border-b border-gray-100 pb-2\">\n          <Database className=\"w-5 h-5 text-brand-red\" /> SQL Script Library\n        </h3>\n\n        {/* SQL 1: Articles */}\n        <div className=\"border border-gray-200 rounded-lg overflow-hidden\">\n          <div className=\"bg-gray-50 px-4 py-2 flex items-center justify-between border-b border-gray-200\">\n            <span className=\"text-xs font-mono font-medium text-gray-700\">1_schema_articles.sql</span>\n            <button\n              onClick={() => handleCopy(sqlArticles, \"articles\")}\n              className=\"p-1 px-2.5 rounded hover:bg-gray-200 text-xs text-gray-600 flex items-center gap-1.5 transition-colors\"\n            >\n              {copiedText === \"articles\" ? (\n                <>\n                  <Check className=\"w-3.5 h-3.5 text-green-500\" /> Copied!\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-3.5 h-3.5\" /> Copy Code\n                </>\n              )}\n            </button>\n          </div>\n          <pre className=\"p-4 bg-gray-900 text-gray-100 text-xs font-mono overflow-x-auto max-h-48 rounded-b-lg\">\n            <code>{sqlArticles}</code>\n          </pre>\n        </div>\n\n        {/* SQL 2: Comments */}\n        <div className=\"border border-gray-200 rounded-lg overflow-hidden\">\n          <div className=\"bg-gray-50 px-4 py-2 flex items-center justify-between border-b border-gray-200\">\n            <span className=\"text-xs font-mono font-medium text-gray-700\">2_schema_comments.sql</span>\n            <button\n              onClick={() => handleCopy(sqlComments, \"comments\")}\n              className=\"p-1 px-2.5 rounded hover:bg-gray-200 text-xs text-gray-600 flex items-center gap-1.5 transition-colors\"\n            >\n              {copiedText === \"comments\" ? (\n                <>\n                  <Check className=\"w-3.5 h-3.5 text-green-500\" /> Copied!\n                </>\n              ) : (\n                <>\n                  <Copy className=\"w-3.5 h-3.5\" /> Copy Code\n                </>\n              )}\n            </button>\n          </div>\n          <pre className=\"p-4 bg-gray-900 text-gray-100 text-xs font-mono overflow-x-auto max-h-48 rounded-b-lg\">\n            <code>{sqlComments}</code>\n          </pre>\n        </div>\n      </div>\n    </div>\n  );\n}\n"
    }
