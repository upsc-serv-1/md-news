    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Article, Comment } from \"../types\";\nimport { newsService } from \"../lib/supabase\";\nimport { X, Calendar, User, Eye, MessageSquare, Send, Share2, Check, Video } from \"lucide-react\";\nimport { motion, AnimatePresence } from \"motion/react\";\n\ninterface ArticleDetailProps {\n  articleId: string;\n  onClose: () => void;\n  onArticleUpdated?: () => void;\n}\n\nexport default function ArticleDetail({ articleId, onClose, onArticleUpdated }: ArticleDetailProps) {\n  const [article, setArticle] = useState<Article | null>(null);\n  const [comments, setComments] = useState<Comment[]>([]);\n  const [commentName, setCommentName] = useState(\"\");\n  const [commentEmail, setCommentEmail] = useState(\"\");\n  const [commentText, setCommentText] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [submittingComment, setSubmittingComment] = useState(false);\n  const [shareCopied, setShareCopied] = useState(false);\n\n  useEffect(() => {\n    async function loadData() {\n      setLoading(true);\n      // Increment views on load\n      await newsService.incrementViews(articleId);\n      if (onArticleUpdated) {\n        onArticleUpdated();\n      }\n\n      const art = await newsService.getArticleById(articleId);\n      if (art) {\n        setArticle(art);\n        const coms = await newsService.getComments(articleId);\n        setComments(coms);\n      }\n      setLoading(false);\n    }\n    loadData();\n  }, [articleId]);\n\n  const handlePostComment = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!commentName || !commentEmail || !commentText) return;\n\n    setSubmittingComment(true);\n    try {\n      const freshComment = await newsService.addComment(articleId, commentName, commentEmail, commentText);\n      setComments((prev) => [...prev, freshComment]);\n      setCommentText(\"\");\n    } catch (e) {\n      console.error(e);\n    } finally {\n      setSubmittingComment(false);\n    }\n  };\n\n  const handleCopyLink = () => {\n    const url = window.location.href + \"?article=\" + articleId;\n    navigator.clipboard.writeText(url);\n    setShareCopied(true);\n    setTimeout(() => setShareCopied(false), 2000);\n  };\n\n  const handleShareWhatsApp = () => {\n    if (!article) return;\n    const text = `\360\237\224\245 *${article.title}*\\n\\n${article.content.substring(0, 100)}...\\n\\n\340\244\252\340\245\202\340\244\260\340\245\200 \340\244\226\340\244\254\340\244\260 \340\244\252\340\245\235\340\245\207\340\244\202 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\252\340\245\215\340\244\262\340\244\270 \340\244\252\340\244\260:\\n${window.location.href}?article=${articleId}`;\n    const url = `https://api.whatsapp.com/send?text=${encodeURIComponent(text)}`;\n    window.open(url, \"_blank\");\n  };\n\n  return (\n    <motion.div\n      initial={{ opacity: 0 }}\n      animate={{ opacity: 1 }}\n      exit={{ opacity: 0 }}\n      className=\"fixed inset-0 z-[100] bg-black/60 flex items-center justify-center p-3 sm:p-4 overflow-y-auto backdrop-blur-sm\"\n    >\n      <motion.div\n        initial={{ scale: 0.95, y: 15 }}\n        animate={{ scale: 1, y: 0 }}\n        exit={{ scale: 0.95, y: 15 }}\n        transition={{ type: \"spring\", damping: 25, stiffness: 350 }}\n        className=\"bg-[#fbf9f8] w-full max-w-3xl rounded-xl shadow-2xl relative overflow-hidden max-h-[92vh] flex flex-col\"\n      >\n        {/* Sticky Header inside modal */}\n        <div className=\"bg-white border-b border-gray-150 p-4 sticky top-0 z-10 flex items-center justify-between\">\n          <span className=\"text-xs font-mono font-bold tracking-wide text-brand-red bg-brand-red/10 px-2.5 py-1 rounded inline-flex items-center gap-1\">\n            {article?.is_video ? <Video className=\"w-3.5 h-3.5\" /> : null}\n            {article?.category?.toUpperCase()}\n          </span>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleShareWhatsApp}\n              className=\"bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white p-1 px-3 rounded text-xs inline-flex items-center gap-1.5 font-label-bold transition-all\"\n            >\n              WhatsApp\n            </button>\n            <button\n              onClick={handleCopyLink}\n              className=\"bg-gray-100 hover:bg-gray-200 active:scale-95 text-gray-700 p-1 px-2.5 rounded text-xs inline-flex items-center gap-1.5 transition-all\"\n            >\n              {shareCopied ? <Check className=\"w-3.5 h-3.5 text-green-600\" /> : <Share2 className=\"w-3.5 h-3.5\" />}\n              {shareCopied ? \"Copied\" : \"Copy Link\"}\n            </button>\n            <button\n              onClick={onClose}\n              className=\"text-gray-400 hover:text-gray-700 p-1 rounded-full transition-colors\"\n            >\n              <X className=\"w-6 h-6\" />\n            </button>\n          </div>\n        </div>\n\n        {loading ? (\n          <div className=\"flex-1 min-h-[400px] flex items-center justify-center\">\n            <div className=\"animate-spin rounded-full h-10 w-10 border-2 border-brand-red border-t-transparent\"></div>\n          </div>\n        ) : article ? (\n          <div className=\"overflow-y-auto flex-1 p-5 sm:p-7\">\n            {/* Meta tags */}\n            <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-brand-dark/60 font-mono mb-4\">\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3.5 h-3.5 text-brand-red\" /> {article.published_at}\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <User className=\"w-3.5 h-3.5 text-brand-red\" /> {article.author}\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Eye className=\"w-3.5 h-3.5 text-brand-red\" /> {article.views} \340\244\265\340\245\215\340\244\257\340\245\202\340\244\234\n              </span>\n            </div>\n\n            {/* Headline */}\n            <h1 className=\"text-xl sm:text-2xl md:text-3xl font-display font-extrabold text-[#1b1c1c] leading-tight tracking-tight mb-5\">\n              {article.title}\n            </h1>\n\n            {/* Image banner */}\n            {article.image_url && (\n              <div className=\"aspect-[16/9] w-full rounded-lg overflow-hidden border border-gray-200 bg-gray-150 mb-6 group relative\">\n                <img\n                  src={article.image_url}\n                  alt={article.title}\n                  className=\"w-full h-full object-cover\"\n                  referrerPolicy=\"no-referrer\"\n                />\n                {article.is_video && (\n                  <div className=\"absolute inset-0 bg-black/40 flex items-center justify-center\">\n                    <div className=\"bg-brand-red text-white px-4 py-2 rounded-full font-label-bold flex items-center gap-2 shadow-lg\">\n                      <Video className=\"w-4 h-4\" /> \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 : {article.video_duration || \"00:00\"}\n                    </div>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* Article Content */}\n            <div className=\"font-body text-base text-[#1b1c1c]/90 leading-relaxed font-normal whitespace-pre-wrap mb-8 border-b border-gray-150 pb-8 tracking-wide\">\n              {article.content}\n            </div>\n\n            {/* Comments Area */}\n            <div className=\"mt-8\">\n              <h3 className=\"font-display font-bold text-lg text-brand-dark flex items-center gap-2 mb-6\">\n                <MessageSquare className=\"w-5 h-5 text-brand-red\" /> \340\244\252\340\244\276\340\244\240\340\244\225\340\245\213\340\244\202 \340\244\225\340\245\200 \340\244\260\340\244\276\340\244\257 ({comments.length})\n              </h3>\n\n              {comments.length === 0 ? (\n                <div className=\"bg-gray-50 rounded-lg p-6 text-center text-sm text-gray-500 mb-6 font-body\">\n                  \340\244\207\340\244\270 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\252\340\244\260 \340\244\205\340\244\255\340\245\200 \340\244\225\340\245\213\340\244\210 \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210\340\245\244 \340\244\252\340\244\271\340\244\262\340\245\200 \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\262\340\244\277\340\244\226\340\244\225\340\244\260 \340\244\205\340\244\252\340\244\250\340\245\200 \340\244\260\340\244\276\340\244\257 \340\244\270\340\244\276\340\244\235\340\244\276 \340\244\225\340\244\260\340\245\207\340\244\202!\n                </div>\n              ) : (\n                <div className=\"space-y-4 mb-8\">\n                  {comments.map((comment) => (\n                    <div key={comment.id} className=\"bg-white border border-gray-150 rounded-lg p-4 shadow-xs\">\n                      <div className=\"flex items-center justify-between mb-2\">\n                        <span className=\"font-label-bold text-sm text-brand-dark\">{comment.author_name}</span>\n                        <span className=\"text-[10px] font-mono text-gray-400\">\n                          {new Date(comment.created_at).toLocaleDateString(\"hi-IN\", {\n                            year: \"numeric\",\n                            month: \"short\",\n                            day: \"numeric\"\n                          })}\n                        </span>\n                      </div>\n                      <p className=\"text-sm font-body text-brand-dark/80 whitespace-pre-wrap leading-relaxed\">\n                        {comment.content}\n                      </p>\n                    </div>\n                  ))}\n                </div>\n              )}\n\n              {/* Comment submission form */}\n              <form onSubmit={handlePostComment} className=\"bg-white border border-gray-200 rounded-lg p-4 sm:p-5 shadow-xs\">\n                <h4 className=\"font-label-bold text-sm text-brand-dark mb-4\">\340\244\205\340\244\252\340\244\250\340\245\200 \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202</h4>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4\">\n                  <div>\n                    <label className=\"block text-[11px] font-mono uppercase text-brand-dark/60 mb-1\">\340\244\252\340\245\202\340\244\260\340\244\276 \340\244\250\340\244\276\340\244\256</label>\n                    <input\n                      type=\"text\"\n                      required\n                      value={commentName}\n                      onChange={(e) => setCommentName(e.target.value)}\n                      placeholder=\"\340\244\211\340\244\246\340\244\276. \340\244\260\340\244\276\340\244\271\340\245\201\340\244\262 \340\244\244\340\245\215\340\244\257\340\244\276\340\244\227\340\245\200\"\n                      className=\"w-full text-sm border border-gray-200 outline-none focus:border-brand-red rounded p-2 bg-gray-50/50 transition-colors\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[11px] font-mono uppercase text-brand-dark/60 mb-1\">\340\244\210\340\244\256\340\245\207\340\244\262 \340\244\252\340\244\244\340\244\276 (\340\244\227\340\245\213\340\244\252\340\244\250\340\245\200\340\244\257 \340\244\260\340\244\271\340\245\207\340\244\227\340\244\276)</label>\n                    <input\n                      type=\"email\"\n                      required\n                      value={commentEmail}\n                      onChange={(e) => setCommentEmail(e.target.value)}\n                      placeholder=\"\340\244\211\340\244\246\340\244\276. rahul@example.com\"\n                      className=\"w-full text-sm border border-gray-200 outline-none focus:border-brand-red rounded p-2 bg-gray-50/50 transition-colors\"\n                    />\n                  </div>\n                </div>\n                <div className=\"mb-4\">\n                  <label className=\"block text-[11px] font-mono uppercase text-brand-dark/60 mb-1\">\340\244\206\340\244\252\340\244\225\340\245\200 \340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200</label>\n                  <textarea\n                    rows={3}\n                    required\n                    value={commentText}\n                    onChange={(e) => setCommentText(e.target.value)}\n                    placeholder=\"\340\244\207\340\244\270 \340\244\265\340\244\277\340\244\267\340\244\257 \340\244\252\340\244\260 \340\244\205\340\244\252\340\244\250\340\245\207 \340\244\265\340\244\277\340\244\232\340\244\276\340\244\260 \340\244\257\340\244\271\340\244\276\340\244\201 \340\244\265\340\245\215\340\244\257\340\244\225\340\245\215\340\244\244 \340\244\225\340\244\260\340\245\207\340\244\202...\"\n                    className=\"w-full text-sm border border-gray-200 outline-none focus:border-brand-red rounded p-2 bg-gray-50/50 transition-colors\"\n                  />\n                </div>\n                <button\n                  type=\"submit\"\n                  disabled={submittingComment}\n                  className=\"bg-brand-red hover:bg-[#9e0010] active:scale-95 disabled:opacity-50 text-white font-label-bold text-xs p-2 px-5 rounded inline-flex items-center gap-2 shadow-sm transition-all cursor-pointer\"\n                >\n                  <Send className=\"w-3.5 h-3.5\" />\n                  {submittingComment ? \"\340\244\252\340\245\215\340\244\260\340\244\225\340\244\276\340\244\266\340\244\277\340\244\244 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\" : \"\340\244\237\340\244\277\340\244\252\340\245\215\340\244\252\340\244\243\340\245\200 \340\244\270\340\244\254\340\244\256\340\244\277\340\244\237 \340\244\225\340\244\260\340\245\207\340\244\202\"}\n                </button>\n              </form>\n            </div>\n          </div>\n        ) : (\n          <div className=\"flex-1 min-h-[400px] flex flex-col items-center justify-center p-6 text-center\">\n            <h1 className=\"text-lg font-bold text-gray-800 mb-2\">\340\244\226\340\244\254\340\244\260 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\245\200</h1>\n            <p className=\"text-sm text-gray-500 mb-4\">\340\244\271\340\245\213 \340\244\270\340\244\225\340\244\244\340\244\276 \340\244\271\340\245\210 \340\244\207\340\244\270\340\245\207 \340\244\252\340\245\215\340\244\260\340\244\266\340\244\276\340\244\270\340\244\225 \340\244\246\340\245\215\340\244\265\340\244\276\340\244\260\340\244\276 \340\244\271\340\244\237\340\244\276 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\213\340\245\244</p>\n            <button onClick={onClose} className=\"bg-brand-red text-white px-4 py-2 rounded text-sm font-label-bold\">\n              \340\244\265\340\244\276\340\244\252\340\244\270 \340\244\234\340\244\276\340\244\217\340\244\201\n            </button>\n          </div>\n        )}\n      </motion.div>\n    </motion.div>\n  );\n}\n"
    }
