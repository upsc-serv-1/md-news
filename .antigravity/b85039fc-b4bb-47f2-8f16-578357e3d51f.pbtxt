    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \"react\";\nimport { Article } from \"./types\";\nimport { newsService } from \"./lib/supabase\";\nimport { CATEGORIES } from \"./data\";\nimport {\n  Search,\n  ChevronRight,\n  Video,\n  Eye,\n  Calendar,\n  User,\n  Settings,\n  X,\n  Compass,\n  Campaign,\n  Tv,\n  Atom,\n  Building,\n  Globe2,\n  Film,\n  Menu,\n  Sun,\n  Moon\n} from \"lucide-react\";\nimport ArticleDetail from \"./components/ArticleDetail\";\nimport AdminPanel from \"./components/AdminPanel\";\nimport { AnimatePresence, motion } from \"motion/react\";\n\nexport default function App() {\n  // Screen routing\n  const [screen, setScreen] = useState<\"home\" | \"admin\">(\"home\");\n\n  // Articles & DB state\n  const [articles, setArticles] = useState<Article[]>([]);\n  const [loading, setLoading] = useState(true);\n\n  // Filter / Interaction States\n  const [selectedCategory, setSelectedCategory] = useState(\"all\");\n  const [selectedArticleId, setSelectedArticleId] = useState<string | null>(null);\n  const [isSearchOpen, setIsSearchOpen] = useState(false);\n  const [searchQuery, setSearchQuery] = useState(\"\");\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  \n  // Theme Toggle (Light / Dark)\n  const [darkMode, setDarkMode] = useState(false);\n\n  const fetchArticles = async () => {\n    setLoading(true);\n    const data = await newsService.getArticles();\n    setArticles(data);\n    setLoading(false);\n  };\n\n  useEffect(() => {\n    fetchArticles();\n    \n    // Auto check if URL query params require loading an article directly\n    const params = new URLSearchParams(window.location.search);\n    const artId = params.get(\"article\");\n    if (artId) {\n      setSelectedArticleId(artId);\n    }\n\n    const adminQuery = params.get(\"screen\");\n    if (adminQuery === \"admin\") {\n      setScreen(\"admin\");\n    }\n  }, []);\n\n  const toggleDarkMode = () => {\n    setDarkMode(!darkMode);\n  };\n\n  // Helper mapping category icons\n  const getCategoryIcon = (id: string) => {\n    switch (id) {\n      case \"politics\":\n        return <Building className=\"w-4 h-4\" />;\n      case \"local\":\n        return <Compass className=\"w-4 h-4\" />;\n      case \"world\":\n        return <Globe2 className=\"w-4 h-4\" />;\n      case \"entertainment\":\n        return <Film className=\"w-4 h-4\" />;\n      case \"video\":\n        return <Tv className=\"w-4 h-4\" />;\n      case \"science-health\":\n        return <Atom className=\"w-4 h-4\" />;\n      default:\n        return <Compass className=\"w-4 h-4\" />;\n    }\n  };\n\n  // Article groupings for layout\n  const breakingNews = articles.filter((a) => a.is_breaking);\n  const heroArticle = articles.find((a) => a.id === \"art-hero\") || articles[0];\n  const sideUpdateArticles = articles.filter(\n    (a) => a.id === \"art-update-1\" || a.id === \"art-update-2\"\n  );\n  \n  // World category articles\n  const worldArticles = articles.filter((a) => a.category === \"world\").slice(0, 4);\n  \n  // Video articles\n  const videoArticles = articles.filter((a) => a.is_video).slice(0, 3);\n  \n  // Science & health articles\n  const scienceArticles = articles.filter((a) => a.category === \"science-health\").slice(0, 2);\n\n  // Search Results\n  const searchResults = searchQuery.trim()\n    ? articles.filter(\n        (a) =>\n          a.title.toLowerCase().includes(searchQuery.toLowerCase()) ||\n          a.content.toLowerCase().includes(searchQuery.toLowerCase())\n      )\n    : [];\n\n  if (screen === \"admin\") {\n    return (\n      <div className={darkMode ? \"dark\" : \"\"}>\n        <div className=\"min-h-screen bg-gray-50 dark:bg-zinc-900 dark:text-gray-100 font-sans transition-colors duration-250\">\n          <AdminPanel\n            onBack={() => setScreen(\"home\")}\n            onDataChanged={fetchArticles}\n          />\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className={darkMode ? \"dark\" : \"\"}>\n      <div className=\"min-h-screen bg-[#fbf9f8] text-[#1b1c1c] dark:bg-zinc-950 dark:text-zinc-50 font-sans transition-colors duration-250 flex flex-col\">\n        \n        {/* TOP SCROLLING MARQUEE BANNER */}\n        <div className=\"bg-brand-red dark:bg-red-800 text-white w-full h-10 flex items-center overflow-hidden z-[60] relative border-b border-red-700/30\">\n          <div className=\"flex items-center h-full pl-4 pr-3 bg-brand-red dark:bg-red-800 z-10 font-bold text-xs uppercase tracking-wider text-white shadow-[4px_0_10px_rgba(0,0,0,0.2)] whitespace-nowrap gap-1\">\n            <span className=\"w-2 h-2 rounded-full bg-white animate-pulse\" />\n            <span>\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\226\340\244\254\340\244\260:</span>\n          </div>\n\n          <div className=\"flex-1 overflow-hidden relative font-medium text-xs\">\n            <div className=\"absolute inset-0 whitespace-nowrap flex items-center animate-marquee cursor-pointer\">\n              {breakingNews.length > 0 ? (\n                breakingNews.map((news) => (\n                  <span\n                    key={news.id}\n                    onClick={() => setSelectedArticleId(news.id)}\n                    className=\"mr-12 hover:underline inline-flex items-center gap-1.5\"\n                  >\n                    \360\237\224\245 {news.title}\n                  </span>\n                ))\n              ) : (\n                <>\n                  <span className=\"mr-12\">\360\237\224\245 \340\244\254\340\244\241\340\244\274\340\245\200 \340\244\226\340\244\254\340\244\260: \340\244\262\340\245\213\340\244\225\340\244\270\340\244\255\340\244\276 \340\244\232\340\245\201\340\244\250\340\244\276\340\244\265 2024 \340\244\225\340\245\207 \340\244\250\340\244\244\340\245\200\340\244\234\340\245\207 \340\244\225\340\244\262 \340\244\230\340\245\213\340\244\267\340\244\277\340\244\244 \340\244\271\340\245\213\340\244\202\340\244\227\340\245\207\340\245\244</span>\n                  <span className=\"mr-12\">\360\237\217\217 \340\244\226\340\245\207\340\244\262: \340\244\255\340\244\276\340\244\260\340\244\244 \340\244\250\340\245\207 \340\244\265\340\244\277\340\244\266\340\245\215\340\244\265 \340\244\225\340\244\252 \340\244\253\340\244\276\340\244\207\340\244\250\340\244\262 \340\244\256\340\245\207\340\244\202 \340\244\252\340\245\215\340\244\260\340\244\265\340\245\207\340\244\266 \340\244\225\340\244\277\340\244\257\340\244\276, \340\244\266\340\244\276\340\244\250\340\244\246\340\244\276\340\244\260 \340\244\234\340\245\200\340\244\244\340\245\244</span>\n                  <span className=\"mr-12\">\360\237\223\210 \340\244\265\340\245\215\340\244\257\340\244\276\340\244\252\340\244\276\340\244\260: \340\244\266\340\245\207\340\244\257\340\244\260 \340\244\254\340\244\276\340\244\234\340\244\276\340\244\260 \340\244\256\340\245\207\340\244\202 \340\244\206\340\244\234 \340\244\255\340\244\276\340\244\260\340\245\200 \340\244\211\340\244\233\340\244\276\340\244\262, \340\244\270\340\245\207\340\244\202\340\244\270\340\245\207\340\244\225\340\245\215\340\244\270 \340\244\260\340\244\277\340\244\225\340\245\211\340\244\260\340\245\215\340\244\241 \340\244\270\340\245\215\340\244\244\340\244\260 \340\244\252\340\244\260\340\245\244</span>\n                </>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* STICKY HEADER */}\n        <header className=\"bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md sticky top-0 z-50 border-b border-gray-150 dark:border-zinc-800 flex justify-between items-center w-full px-4 sm:px-8 py-3 max-w-7xl mx-auto transition-colors\">\n          <div className=\"flex items-center gap-4\">\n            <button\n              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n              className=\"lg:hidden text-brand-red dark:text-red-500 hover:bg-gray-100 p-1 rounded\"\n            >\n              <Menu className=\"w-6 h-6\" />\n            </button>\n            <a\n              onClick={() => setSelectedCategory(\"all\")}\n              className=\"font-display font-extrabold text-lg sm:text-2xl text-brand-red dark:text-red-500 tracking-tight cursor-pointer\"\n            >\n              Samachar Plus\n            </a>\n          </div>\n\n          {/* Nav Categories - Desktop */}\n          <nav className=\"hidden lg:flex items-center gap-5 xl:gap-7 font-mono text-xs font-bold uppercase\">\n            <button\n              onClick={() => setSelectedCategory(\"all\")}\n              className={`pb-1 transition-colors ${\n                selectedCategory === \"all\"\n                  ? \"border-b-2 border-brand-red text-brand-red dark:text-red-500\"\n                  : \"text-gray-500 dark:text-zinc-400 hover:text-brand-red\"\n              }`}\n            >\n              \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260\n            </button>\n            {CATEGORIES.map((cat) => (\n              <button\n                key={cat.id}\n                onClick={() => setSelectedCategory(cat.id)}\n                className={`pb-1 transition-colors hover:text-brand-red ${\n                  selectedCategory === cat.id\n                    ? \"border-b-2 border-brand-red text-brand-red dark:text-red-500\"\n                    : \"text-gray-500 dark:text-zinc-400\"\n                }`}\n              >\n                {cat.name_hi}\n              </button>\n            ))}\n          </nav>\n\n          {/* Action Tools */}\n          <div className=\"flex items-center gap-2.5 text-brand-red dark:text-red-400\">\n            <button\n              onClick={toggleDarkMode}\n              className=\"hover:bg-gray-100 dark:hover:bg-zinc-800 p-1.5 rounded transition-colors inline-flex\"\n              title=\"Toggle Dark Mode\"\n            >\n              {darkMode ? <Sun className=\"w-5 h-5 text-amber-400\" /> : <Moon className=\"w-5 h-5 text-zinc-600\" />}\n            </button>\n            <button\n              onClick={() => setIsSearchOpen(true)}\n              className=\"hover:bg-gray-100 dark:hover:bg-zinc-800 p-1.5 rounded transition-colors inline-flex\"\n              title=\"Search News\"\n            >\n              <Search className=\"w-5 h-5 text-gray-700 dark:text-zinc-200\" />\n            </button>\n            <button\n              onClick={() => setScreen(\"admin\")}\n              className=\"bg-brand-red/10 hover:bg-brand-red/20 text-brand-red dark:text-red-400 p-1.5 px-3 rounded text-[11px] font-bold font-mono inline-flex items-center gap-1 cursor-pointer\"\n              title=\"Admin Portal\"\n            >\n              <Settings className=\"w-3.5 h-3.5 animate-spin-slow\" />\n              <span>\340\244\252\340\245\215\340\244\260\340\244\266\340\244\276\340\244\270\340\244\225</span>\n            </button>\n          </div>\n        </header>\n\n        {/* MOBILE MENU ACCORDION */}\n        <AnimatePresence>\n          {mobileMenuOpen && (\n            <motion.div\n              initial={{ opacity: 0, height: 0 }}\n              animate={{ opacity: 1, height: \"auto\" }}\n              exit={{ opacity: 0, height: 0 }}\n              className=\"lg:hidden bg-white dark:bg-zinc-900 border-b border-gray-200 dark:border-zinc-800 max-w-7xl mx-auto w-full px-4 overflow-hidden z-40 relative\"\n            >\n              <div className=\"py-3 flex flex-col gap-2.5 text-xs font-bold font-mono tracking-wider\">\n                <button\n                  onClick={() => {\n                    setSelectedCategory(\"all\");\n                    setMobileMenuOpen(false);\n                  }}\n                  className={`p-2 rounded text-left ${\n                    selectedCategory === \"all\" ? \"bg-brand-red/10 text-brand-red\" : \"text-gray-600 dark:text-zinc-300\"\n                  }`}\n                >\n                  \340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260\n                </button>\n                {CATEGORIES.map((cat) => (\n                  <button\n                    key={cat.id}\n                    onClick={() => {\n                      setSelectedCategory(cat.id);\n                      setMobileMenuOpen(false);\n                    }}\n                    className={`p-2 rounded text-left flex items-center gap-2.5 ${\n                      selectedCategory === cat.id ? \"bg-brand-red/10 text-brand-red\" : \"text-gray-600 dark:text-zinc-300\"\n                    }`}\n                  >\n                    {getCategoryIcon(cat.id)}\n                    {cat.name_hi}\n                  </button>\n                ))}\n              </div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* LOADING SHIMMER */}\n        {loading ? (\n          <div className=\"flex-grow flex items-center justify-center min-h-[50vh]\">\n            <div className=\"animate-spin rounded-full h-12 w-12 border-4 border-brand-red border-t-transparent shadow-md\"></div>\n          </div>\n        ) : (\n          <main className=\"flex-grow w-full max-w-7xl mx-auto px-4 sm:px-8 py-6 flex flex-col gap-10\">\n            \n            {/* DISPLAY HERO BLOCK ONLY WHEN FEED IS NOT FILTERED */}\n            {selectedCategory === \"all\" && (\n              <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n                {/* LHS Highlight Banner */}\n                {heroArticle && (\n                  <article\n                    onClick={() => setSelectedArticleId(heroArticle.id)}\n                    className=\"lg:col-span-8 group cursor-pointer relative overflow-hidden rounded-xl border border-gray-200/65 dark:border-zinc-800 shadow-sm\"\n                  >\n                    <div className=\"aspect-[16/9] w-full overflow-hidden bg-gray-150 dark:bg-zinc-800 relative\">\n                      <img\n                        src={heroArticle.image_url}\n                        alt={heroArticle.title}\n                        className=\"w-full h-full object-cover transition-transform duration-750 group-hover:scale-102\"\n                        referrerPolicy=\"no-referrer\"\n                      />\n                      {/* Gradient overlay */}\n                      <div className=\"absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent\" />\n                    </div>\n                    {/* Positioned Typography */}\n                    <div className=\"p-4 sm:p-6 absolute bottom-0 left-0 right-0 text-white flex flex-col items-start font-body\">\n                      <span className=\"inline-block bg-brand-red/90 text-white font-mono text-[10px] uppercase font-bold px-2 py-0.5 rounded mb-2.5 md:mb-3\">\n                        {CATEGORIES.find((c) => c.id === heroArticle.category)?.name_hi || \"\340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277\"}\n                      </span>\n                      <h1 className=\"text-sm sm:text-lg md:text-2xl font-display font-bold leading-tight line-clamp-2 sm:line-clamp-3 mb-1.5\">\n                        {heroArticle.title}\n                      </h1>\n                      <p className=\"text-2xs sm:text-xs text-zinc-300 line-clamp-2 md:line-clamp-3 leading-relaxed\">\n                        {heroArticle.content.substring(0, 160)}...\n                      </p>\n                    </div>\n                  </article>\n                )}\n\n                {/* RHS Columns: Recent updates news & Ads */}\n                <div className=\"lg:col-span-4 flex flex-col gap-4\">\n                  <h2 className=\"text-sm font-display font-black text-brand-red dark:text-red-500 border-b border-gray-150 dark:border-zinc-800 pb-2 uppercase tracking-tight flex items-center justify-between\">\n                    <span>\340\244\244\340\244\276\340\244\234\340\244\274\340\244\276 \340\244\205\340\244\252\340\244\241\340\245\207\340\244\237</span>\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-brand-red animate-ping\" />\n                  </h2>\n\n                  <div className=\"flex flex-col gap-4\">\n                    {sideUpdateArticles.map((art) => (\n                      <a\n                        key={art.id}\n                        onClick={() => setSelectedArticleId(art.id)}\n                        className=\"flex gap-3 group cursor-pointer\"\n                      >\n                        <div className=\"w-20 h-20 shrink-0 rounded-lg overflow-hidden border border-gray-200 bg-gray-100\">\n                          <img\n                            src={art.image_url}\n                            alt={art.title}\n                            className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                            referrerPolicy=\"no-referrer\"\n                          />\n                        </div>\n                        <div className=\"flex flex-col justify-center font-body\">\n                          <h3 className=\"text-xs font-semibold text-gray-900 dark:text-zinc-100 group-hover:text-brand-red transition-colors line-clamp-2\">\n                            {art.title}\n                          </h3>\n                          <span className=\"text-[10px] font-mono text-gray-500 mt-1 flex items-center gap-1\">\n                            <Calendar className=\"w-2.5 h-2.5 text-brand-red\" /> {art.published_at}\n                          </span>\n                        </div>\n                      </a>\n                    ))}\n\n                    {/* Standard sponsored advertisement block */}\n                    <div className=\"w-full h-24 bg-gray-50 dark:bg-zinc-900 border border-gray-150 dark:border-zinc-800 flex items-center justify-center rounded-lg mt-1 group\">\n                      <span className=\"font-mono text-[9px] text-gray-400 dark:text-zinc-500 tracking-widest uppercase transition-colors group-hover:text-brand-red\">\n                        \342\200\224 \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 / Sponsored \342\200\224\n                      </span>\n                    </div>\n                  </div>\n                </div>\n              </section>\n            )}\n\n            {/* DYNAMIC WORLD / INTERNATIONAL SECTION */}\n            {selectedCategory === \"all\" && worldArticles.length > 0 && (\n              <section className=\"scroll-mt-24\">\n                <div className=\"flex items-center justify-between border-b border-brand-red mb-6\">\n                  <h2 className=\"font-display font-extrabold text-[#111827] dark:text-white pb-2 flex items-center gap-2\">\n                    <Globe2 className=\"w-5 h-5 text-brand-red\" /> \340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276 (International)\n                  </h2>\n                  <button\n                    onClick={() => setSelectedCategory(\"world\")}\n                    className=\"text-[10px] font-mono font-bold text-brand-red dark:text-red-500 hover:underline\"\n                  >\n                    \340\244\270\340\244\255\340\245\200 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 &gt;\n                  </button>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n                  {worldArticles.map((art) => (\n                    <a\n                      key={art.id}\n                      onClick={() => setSelectedArticleId(art.id)}\n                      className=\"group flex flex-col cursor-pointer bg-white dark:bg-zinc-900 border border-gray-150 dark:border-zinc-800 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition-all duration-300\"\n                    >\n                      <div className=\"aspect-video w-full overflow-hidden bg-gray-100\">\n                        <img\n                          src={art.image_url}\n                          alt={art.title}\n                          className=\"w-full h-full object-cover group-hover:scale-102 transition-transform duration-500\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                      </div>\n                      <div className=\"p-3.5 flex-grow flex flex-col justify-between font-body\">\n                        <h3 className=\"text-xs font-bold text-gray-900 dark:text-zinc-100 group-hover:text-brand-red line-clamp-2 leading-snug\">\n                          {art.title}\n                        </h3>\n                        <span className=\"text-[9px] font-mono text-gray-50block mt-3 block text-gray-400\">\n                          {art.published_at}\n                        </span>\n                      </div>\n                    </a>\n                  ))}\n                </div>\n              </section>\n            )}\n\n            {/* SIZABLE LEADERBOARD SPONSORED BANNER AD */}\n            {selectedCategory === \"all\" && (\n              <section className=\"w-full h-[85px] sm:h-[135px] bg-[#efeded]/70 dark:bg-zinc-900 border border-gray-150 dark:border-zinc-800 flex items-center justify-center rounded-xl overflow-hidden select-none relative group\">\n                <span className=\"font-mono text-[10px] text-gray-400 dark:text-zinc-500 tracking-widest uppercase transition-colors group-hover:text-brand-red z-10\">\n                  \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\252\340\244\250 - 970 x 250 (Sponsored Leaderboard Space)\n                </span>\n                <div className=\"absolute right-4 bottom-2 text-[8px] font-mono text-gray-300\">SAMACHAR PLUS DISPLAY LAYER</div>\n              </section>\n            )}\n\n            {/* SLEEK VIDEO NEWS HORIZONTAL BAR CONTAINER */}\n            {selectedCategory === \"all\" && videoArticles.length > 0 && (\n              <section className=\"bg-zinc-900 dark:bg-zinc-950 p-5 sm:p-7 rounded-xl border border-zinc-850 shadow-lg select-normal\">\n                <div className=\"flex items-center gap-2 mb-6 border-b border-zinc-800 pb-3\">\n                  <Tv className=\"w-6 h-6 text-brand-red animate-pulse\" />\n                  <h2 className=\"font-display font-extrabold text-sm sm:text-base text-white tracking-wide uppercase\">\n                    \340\244\265\340\245\200\340\244\241\340\244\277\340\244\257\340\245\213 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 (Exclusive Clips)\n                  </h2>\n                </div>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n                  {videoArticles.map((video) => (\n                    <div\n                      key={video.id}\n                      onClick={() => setSelectedArticleId(video.id)}\n                      className=\"group cursor-pointer flex flex-col bg-zinc-900 border border-zinc-800 rounded-lg overflow-hidden hover:border-zinc-700 transition-all shadow-md\"\n                    >\n                      <div className=\"relative aspect-video w-full overflow-hidden bg-black\">\n                        <img\n                          src={video.image_url}\n                          alt={video.title}\n                          className=\"w-full h-full object-cover opacity-75 group-hover:scale-102 transition-transform duration-500\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                        <div className=\"absolute inset-0 flex items-center justify-center\">\n                          <span className=\"w-12 h-12 rounded-full bg-brand-red flex items-center justify-center text-white opacity-90 group-hover:opacity-100 group-hover:scale-110 shadow-lg transition-all\">\n                            <Video className=\"w-5 h-5 fill-current\" />\n                          </span>\n                        </div>\n                        {video.video_duration && (\n                          <div className=\"absolute bottom-2.5 right-2.5 bg-black/85 text-white text-[9px] px-1.5 py-0.5 rounded font-bold font-mono\">\n                            {video.video_duration}\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"p-3 font-body\">\n                        <h3 className=\"text-xs font-bold text-gray-100 group-hover:text-brand-red line-clamp-2 leading-relaxed\">\n                          {video.title}\n                        </h3>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              </section>\n            )}\n\n            {/* SCIENCE & HEALTH BANNER */}\n            {selectedCategory === \"all\" && scienceArticles.length > 0 && (\n              <section className=\"scroll-mt-24\">\n                <div className=\"flex items-center justify-between border-b border-brand-red mb-6\">\n                  <h2 className=\"font-display font-extrabold text-[#111827] dark:text-white pb-2 flex items-center gap-2\">\n                    <Atom className=\"w-5 h-5 text-brand-red\" /> \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250 \340\244\224\340\244\260 \340\244\270\340\245\215\340\244\265\340\244\276\340\244\270\340\245\215\340\244\245\340\245\215\340\244\257\n                  </h2>\n                  <button\n                    onClick={() => setSelectedCategory(\"science-health\")}\n                    className=\"text-[10px] font-mono font-bold text-brand-red dark:text-red-500 hover:underline\"\n                  >\n                    \340\244\270\340\244\255\340\245\200 \340\244\246\340\245\207\340\244\226\340\245\207\340\244\202 &gt;\n                  </button>\n                </div>\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                  {scienceArticles.map((art) => (\n                    <a\n                      key={art.id}\n                      onClick={() => setSelectedArticleId(art.id)}\n                      className=\"flex flex-col sm:flex-row gap-4 group p-3.5 border border-gray-150 dark:border-zinc-800 dark:bg-zinc-900/40 rounded-xl hover:bg-white hover:shadow-md transition-all cursor-pointer shadow-xs\"\n                    >\n                      <div className=\"w-full sm:w-32 aspect-square rounded-lg overflow-hidden bg-gray-100 flex-shrink-0\">\n                        <img\n                          src={art.image_url}\n                          alt={art.title}\n                          className=\"w-full h-full object-cover group-hover:scale-103 transition-transform duration-500\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                      </div>\n                      <div className=\"flex flex-col justify-between font-body\">\n                        <div>\n                          <h3 className=\"text-xs sm:text-sm font-bold text-gray-900 dark:text-zinc-100 group-hover:text-brand-red leading-snug mb-1\">\n                            {art.title}\n                          </h3>\n                          <p className=\"text-[11px] text-gray-500 line-clamp-2\">\n                            {art.content}\n                          </p>\n                        </div>\n                        <span className=\"text-[10px] text-brand-red font-bold mt-2 font-mono\">\n                          {art.published_at}\n                        </span>\n                      </div>\n                    </a>\n                  ))}\n                </div>\n              </section>\n            )}\n\n            {/* PRIMARY DYNAMIC FEED PORTLET OR \"\340\244\205\340\244\250\340\245\215\340\244\257 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202\" */}\n            <section className=\"scroll-mt-24\">\n              <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-gray-200 pb-3\">\n                <h2 className=\"font-display font-black text-[#111827] dark:text-white text-base sm:text-lg flex items-center gap-2\">\n                  <span>\n                    {selectedCategory === \"all\"\n                      ? \"\340\244\205\340\244\250\340\245\215\340\244\257 \340\244\252\340\245\215\340\244\260\340\244\256\340\245\201\340\244\226 \340\244\226\340\244\254\340\244\260\340\245\207\340\244\202 (\340\244\271\340\244\276\340\244\262\340\244\277\340\244\257\340\244\276)\"\n                      : `${CATEGORIES.find((c) => c.id === selectedCategory)?.name_hi} \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260`}\n                  </span>\n                  <span className=\"text-xs font-mono font-semibold px-2 py-0.5 rounded-full bg-gray-100 dark:bg-zinc-800 text-gray-500 dark:text-zinc-400\">\n                    {articles.filter((a) => selectedCategory === \"all\" || a.category === selectedCategory).length}\n                  </span>\n                </h2>\n\n                {/* Sub category filter tabs inline */}\n                {selectedCategory === \"all\" && (\n                  <div className=\"flex gap-2.5 font-mono text-[10px] font-bold overflow-x-auto pb-1 no-scrollbar select-none\">\n                    <button\n                      onClick={() => setSelectedCategory(\"all\")}\n                      className=\"p-1 px-3 bg-brand-red text-white rounded-full leading-normal shrink-0\"\n                    >\n                      \340\244\270\340\244\255\340\245\200 \340\244\266\340\245\215\340\244\260\340\245\207\340\244\243\340\245\200\n                    </button>\n                    {CATEGORIES.map((cat) => (\n                      <button\n                        key={cat.id}\n                        onClick={() => setSelectedCategory(cat.id)}\n                        className=\"p-1 px-3 bg-gray-100 dark:bg-zinc-800 text-gray-600 dark:text-zinc-400 rounded-full hover:bg-gray-200 transition-colors shrink-0\"\n                      >\n                        {cat.name_hi}\n                      </button>\n                    ))}\n                  </div>\n                )}\n              </div>\n\n              {/* Grid content feed */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6\">\n                {articles\n                  .filter((art) => selectedCategory === \"all\" || art.category === selectedCategory)\n                  .map((art) => (\n                    <article\n                      key={art.id}\n                      onClick={() => setSelectedArticleId(art.id)}\n                      className=\"flex flex-col gap-2.5 group cursor-pointer bg-white dark:bg-zinc-900 border border-gray-150 dark:border-zinc-800 rounded-xl overflow-hidden p-3 hover:shadow-md transition-all\"\n                    >\n                      <div className=\"aspect-video rounded-lg overflow-hidden bg-gray-100 border border-gray-150/50 dark:border-zinc-800/80 relative\">\n                        <img\n                          src={art.image_url}\n                          alt={art.title}\n                          className=\"w-full h-full object-cover group-hover:scale-102 transition-transform duration-500\"\n                          referrerPolicy=\"no-referrer\"\n                        />\n                        {art.is_video && (\n                          <div className=\"absolute top-2 left-2 bg-black/80 text-white rounded-full p-1 border border-white/10 flex items-center justify-center\">\n                            <Video className=\"w-3 h-3 text-brand-red\" />\n                          </div>\n                        )}\n                      </div>\n                      <div className=\"flex-grow flex flex-col justify-between font-body\">\n                        <div>\n                          <span className=\"text-[9px] font-mono text-brand-red font-bold uppercase tracking-wider mb-1 block\">\n                            {CATEGORIES.find((c) => c.id === art.category)?.name_hi}\n                          </span>\n                          <h4 className=\"font-bold text-xs text-gray-900 dark:text-zinc-100 group-hover:text-brand-red leading-snug line-clamp-2\">\n                            {art.title}\n                          </h4>\n                        </div>\n                        <span className=\"text-[9px] font-mono text-gray-400 block mt-2.5\">\n                          {art.published_at} \342\200\242 Views: {art.views || 0}\n                        </span>\n                      </div>\n                    </article>\n                  ))}\n              </div>\n            </section>\n          </main>\n        )}\n\n        {/* COMPREHENSIVE STATIC SEARCH BAR OVERLAY */}\n        <AnimatePresence>\n          {isSearchOpen && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              exit={{ opacity: 0 }}\n              className=\"fixed inset-0 z-[110] bg-black/55 backdrop-blur-sm flex items-start justify-center p-4 pt-16\"\n            >\n              <motion.div\n                initial={{ y: -30, scale: 0.95 }}\n                animate={{ y: 0, scale: 1 }}\n                exit={{ y: -30, scale: 0.95 }}\n                className=\"bg-white dark:bg-zinc-900 w-full max-w-xl rounded-xl shadow-2xl relative overflow-hidden\"\n              >\n                <div className=\"p-4 border-b dark:border-zinc-800 flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2 flex-grow\">\n                    <Search className=\"w-5 h-5 text-gray-400\" />\n                    <input\n                      type=\"text\"\n                      autoFocus\n                      value={searchQuery}\n                      onChange={(e) => setSearchQuery(e.target.value)}\n                      placeholder=\"\340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260, \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241\340\245\215\340\244\270 \340\244\257\340\244\276 \340\244\262\340\245\207\340\244\226\340\244\225 \340\244\225\340\244\276 \340\244\250\340\244\276\340\244\256 \340\244\226\340\245\213\340\244\234\340\245\207\340\244\202...\"\n                      className=\"w-full text-sm outline-none bg-transparent border-none text-gray-800 dark:text-zinc-100\"\n                    />\n                  </div>\n                  <button\n                    onClick={() => {\n                      setIsSearchOpen(false);\n                      setSearchQuery(\"\");\n                    }}\n                    className=\"text-gray-400 hover:text-gray-600 rounded-full\"\n                  >\n                    <X className=\"w-5 h-5\" />\n                  </button>\n                </div>\n\n                <div className=\"p-4 max-h-[350px] overflow-y-auto font-body text-xs\">\n                  {searchQuery.trim() === \"\" ? (\n                    <div className=\"text-center text-gray-400 p-6\">\n                      \340\244\270\340\244\260\340\245\215\340\244\232 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241\340\245\215\340\244\270 \340\244\237\340\244\276\340\244\207\340\244\252 \340\244\225\340\244\260\340\245\207\340\244\202... (\340\244\211\340\244\246\340\244\276. \340\244\232\340\245\201\340\244\250\340\244\276\340\244\265, \340\244\265\340\244\277\340\244\234\340\245\215\340\244\236\340\244\276\340\244\250, \340\244\206\340\244\210\340\244\252\340\245\200\340\244\217\340\244\262)\n                    </div>\n                  ) : searchResults.length === 0 ? (\n                    <div className=\"text-center text-gray-500 p-6\">\n                      \340\244\207\340\244\270 \340\244\225\340\245\200\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\225\340\245\207 \340\244\270\340\244\276\340\244\245 \340\244\225\340\245\213\340\244\210 \340\244\262\340\245\207\340\244\226 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244\n                    </div>\n                  ) : (\n                    <div className=\"space-y-3 font-body\">\n                      <span className=\"block text-[10px] font-mono text-gray-400 text-left mb-2\">\340\244\256\340\244\277\340\244\262\340\245\207 \340\244\252\340\244\260\340\244\277\340\244\243\340\244\276\340\244\256 ({searchResults.length})</span>\n                      {searchResults.map((art) => (\n                        <a\n                          key={art.id}\n                          onClick={() => {\n                            setSelectedArticleId(art.id);\n                            setIsSearchOpen(false);\n                            setSearchQuery(\"\");\n                          }}\n                          className=\"flex gap-3 p-2 hover:bg-gray-50/70 dark:hover:bg-zinc-800/50 rounded-lg cursor-pointer transition-colors text-left\"\n                        >\n                          <div className=\"w-12 h-12 rounded bg-gray-100 overflow-hidden shrink-0 border\">\n                            <img src={art.image_url} className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                          </div>\n                          <div className=\"flex flex-col justify-center\">\n                            <span className=\"font-bold text-gray-900 dark:text-zinc-100 line-clamp-1\">{art.title}</span>\n                            <span className=\"text-[10px] text-gray-400 mt-0.5 font-mono\">{art.published_at}</span>\n                          </div>\n                        </a>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              </motion.div>\n            </motion.div>\n          )}\n        </AnimatePresence>\n\n        {/* LIGHTBOX POPUP DETAIL OVERLAY AREA */}\n        <AnimatePresence>\n          {selectedArticleId && (\n            <ArticleDetail\n              articleId={selectedArticleId}\n              onClose={() => {\n                setSelectedArticleId(null);\n                // Clear query params safekeeping URL aesthetic\n                const url = new URL(window.location.href);\n                url.searchParams.delete(\"article\");\n                window.history.pushState({}, \"\", url.toString());\n              }}\n              onArticleUpdated={fetchArticles}\n            />\n          )}\n        </AnimatePresence>\n\n        {/* FOOTER */}\n        <footer className=\"bg-[#e4e2e2] dark:bg-zinc-900 border-t border-gray-250 dark:border-zinc-800 py-10 px-4 sm:px-8 mt-12 transition-colors\">\n          <div className=\"max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-6\">\n            <div className=\"md:col-span-1 flex flex-col gap-3 font-body\">\n              <span className=\"font-display font-extrabold text-[#ba0013] dark:text-red-500 text-lg\">Samachar Plus</span>\n              <p className=\"text-xs text-brand-dark/70 dark:text-zinc-400 leading-normal\">\n                \340\244\265\340\244\277\340\244\266\340\245\215\340\244\265\340\244\270\340\244\250\340\245\200\340\244\257 \340\244\224\340\244\260 \340\244\250\340\244\277\340\244\267\340\245\215\340\244\252\340\244\225\340\245\215\340\244\267 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260, 24/7\340\245\244 \340\244\271\340\244\277\340\244\202\340\244\246\340\245\200 \340\244\234\340\244\227\340\244\244 \340\244\225\340\244\276 \340\244\270\340\244\260\340\245\215\340\244\265\340\244\266\340\245\215\340\244\260\340\245\207\340\244\267\340\245\215\340\244\240 \340\244\270\340\244\256\340\244\276\340\244\232\340\244\276\340\244\260 \340\244\256\340\244\202\340\244\232\340\245\244\n              </p>\n            </div>\n            \n            <div className=\"md:col-span-3 flex flex-wrap gap-x-8 gap-y-3.5 items-center md:justify-end text-xs font-mono font-bold\">\n              <button onClick={() => setSelectedCategory(\"all\")} className=\"hover:text-brand-red dark:hover:text-red-400 transition-colors\">\340\244\246\340\244\256\340\244\246\340\244\276\340\244\260 \340\244\226\340\244\254\340\244\260</button>\n              <button onClick={() => setSelectedCategory(\"all\")} className=\"hover:text-brand-red dark:hover:text-red-400 transition-colors\">\340\244\260\340\244\276\340\244\234\340\244\250\340\245\200\340\244\244\340\244\277</button>\n              <button onClick={() => setSelectedCategory(\"all\")} className=\"hover:text-brand-red dark:hover:text-red-400 transition-colors\">\340\244\246\340\245\201\340\244\250\340\244\277\340\244\257\340\244\276</button>\n              <button onClick={() => setScreen(\"admin\")} className=\"text-brand-red hover:underline transition-colors flex items-center gap-1\">\n                <Settings className=\"w-3.5 h-3.5\" /> \340\244\250\340\244\277\340\244\257\340\244\202\340\244\244\340\245\215\340\244\260\340\244\243 \340\244\225\340\244\225\340\245\215\340\244\267 (\340\244\252\340\245\215\340\244\260\340\244\266\340\244\276\340\244\270\340\244\225)\n              </button>\n            </div>\n          </div>\n\n          <div className=\"max-w-7xl mx-auto mt-8 pt-4 border-t border-gray-300 dark:border-zinc-800 text-center text-xs text-gray-500 font-body\">\n            \302\251 2026 Samachar Plus. \340\244\270\340\244\260\340\245\215\340\244\265\340\244\276\340\244\247\340\244\277\340\244\225\340\244\276\340\244\260 \340\244\270\340\245\201\340\244\260\340\244\225\340\245\215\340\244\267\340\244\277\340\244\244\340\245\244 \342\200\242 Built inside Cloud Native Applet Ecosystem\n          </div>\n        </footer>\n\n      </div>\n    </div>\n  );\n}\n"
    }
    diff {
      end_line: 8
      unified_diff {
        lines {
          text: "/**"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
