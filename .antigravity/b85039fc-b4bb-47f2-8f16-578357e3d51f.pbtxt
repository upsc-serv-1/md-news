          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "import React, { useState, useEffect } from \"react\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { Article } from \"./types\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { newsService } from \"./lib/supabase\";"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
